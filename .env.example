# ---------------------------------------------------------------------------
# FEARLESS ESPORTS · environment
# Copy to .env.local. Leave everything blank to run the full demo mode.
# ---------------------------------------------------------------------------

# Public URL of this deployment (no trailing slash). Used for metadata,
# payment return URLs and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project Settings → API. Without these the app runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in is configured in Supabase → Authentication → Providers.
# This app needs no Google client ID or secret: keep the secret in Supabase.

# --- Payments: YouPI PG (self-hosted, open source) ------------------------
# https://github.com/youpi-pg/YouPI-PG
# Both public values are needed by the checkout UI to select YouPI.
NEXT_PUBLIC_YOUPI_BASE_URL=
NEXT_PUBLIC_YOUPI_MERCHANT_ID=
YOUPI_API_KEY=
YOUPI_WEBHOOK_SECRET=
# true: only statement-reconciled credits confirm a slot (safest, slowest).
# false: a signed SUCCESS webhook confirms immediately — fully hands-off,
# no admin approval, but you carry the chargeback risk.
# Either way, /api/cron/reconcile-payments sweeps missed webhooks.
YOUPI_REQUIRE_RECONCILED=false

# --- Payments: direct UPI fallback ----------------------------------------
# Used when YouPI is not configured. Players pay the VPA and submit a UTR;
# an admin confirms it from /admin.
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=Fearless Esports

# --- Support --------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@fearlessesports.gg
# Digits only, including country code, e.g. 919876543210.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# --- Housekeeping ---------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`.
# Leave blank to allow /api/cron/release-holds only in local development.
CRON_SECRET=
